# Optional: no key means deterministic offline demo output.
INTERN_API_KEY=
INTERN_BASE_URL=https://discovery-api.intern-ai.org.cn
# Use a complete versioned model name, never an alias or [1M] suffix.
INTERN_MODEL=deepseek-v4-flash-0731

# Optional independent search quota. Without a key, public Exa MCP is used.
# Server-side only; never paste keys into browser forms or commit .env.local.
EXA_API_KEY=

# Optional document import AI; server-side only. Empty key reuses INTERN_* above.
# Use "openai" for OpenAI-compatible chat completions, "anthropic" for messages.
# Base URL is host or host/v1, not the complete completion/messages endpoint.
# Without any key, labelled TXT/CSV/JSON and extracted document text use local rules.
IMPORT_API_KEY=
IMPORT_PROVIDER=anthropic
IMPORT_BASE_URL=
IMPORT_MODEL=
